# deploy/docker-compose.yml's settings. Generate the secrets with: openssl rand -base64 48
SERVER_HOSTNAME=mail.example.com
POSTGRES_PASSWORD=CHANGE_ME
# Signs the admin UI's logins (at least 32 characters); the same value in no other place.
COSMOMAIL_JWT_SECRET=CHANGE_ME
# The transactional email API's token (X-Postmark-Server-Token); empty: /postmark answers 503.
COSMOMAIL_POSTMARK_TOKEN=
# The admin UI's session cookie (at least 32 characters).
NUXT_SESSION_PASSWORD=CHANGE_ME
MAILSERVER_IMAGE=mailserver:dev
ADMIN_UI_IMAGE=mailserver-admin-ui:dev
# Behind CosmoProxy: its certificate directory for the mail hostname.
PROXY_CERT_DIR=/data/cosmoproxy/conf/certs/mail.example.com
# docker-compose.https-proxy.yml: the public address to bind the mail ports to, when a local MTA holds
# 127.0.0.1:25 (default: all addresses).
# PUBLIC_IP=203.0.113.10
