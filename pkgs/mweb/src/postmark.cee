// The transactional email API under /postmark, as the C# server's PostmarkController and TransactionalController
// answered it: a Postmark-style send (POST /postmark/email), templates rendered with Liquid (create, read, update,
// list, delete, send, batch send), each message's events and status, and each domain's suppression list.
//
// Every call carries X-Postmark-Server-Token, compared in constant time with `[admin] postmark_token` (env
// COSMOMAIL_POSTMARK_TOKEN); wrong tokens count as failed logins from the client's address. The sender's domain must
// be one of this server's. A message goes where submitted mail goes: local recipients' inboxes, and the queue for the
// others, in one transaction; the relay DKIM-signs it with the From domain's key and records its events. JSON
// member names are read in any case (Postmark's `From` or the C# samples' `from`); answers use the C# server's
// camelCase. Bodies may be up to `RequestLimits.uploadBody`.

import encoding.Base64;
import encoding.Hex;
import mhttp.JsonDocument;
import mhttp.JsonKind;
import mhttp.JsonWriter;
import mhttp.Request;
import mhttp.Response;
import mhttp.appendIsoTime;
import mhttp.percentDecode;
import mhttp.segment;
import mhttp.segmentCount;
import mmime.MessageIndex;
import mmime.MimeScanner;
import mmime.Renderer;
import mmime.encodeMeta;
import msmtp.loginBlocked;
import msmtp.loginFailed;
import mstore.BlobStore;
import mstore.BlobWriter;
import mstore.Delivered;
import mstore.Delivery;
import mstore.Outbound;
import mstore.Recipient;
import mstore.StoreError;
import postgres.PgParams;
import postgres.PgRows;
import sha256.constantTimeEqual;

/// The most decoded attachment bytes in one send, as the C# server allowed.
const PM_MAX_ATTACHMENTS: usize = 26214400;
/// The most recipients of one message (To, Cc and Bcc together), as Postmark allows.
const PM_MAX_RECIPIENTS: usize = 50;
/// The most recipients of one batch send.
const PM_MAX_BATCH: usize = 500;

/// `{"errorCode": code, "message": message}`, the shape of the C# server's Postmark errors.
fn pmError(status: u16, code: i64, message: StringView) -> Result<Response, AllocError> {
    var w = JsonWriter.create();
    w.beginObject();
    w.integerField("errorCode", code);
    w.stringField("message", message);
    w.endObject();
    return Response.json(status, w.finish()?);
}

/// `{"error": message, "email": email}`.
fn pmRefused(status: u16, message: StringView, email: StringView) -> Result<Response, AllocError> {
    var w = JsonWriter.create();
    w.beginObject();
    w.stringField("error", message);
    w.stringField("email", email);
    w.endObject();
    return Response.json(status, w.finish()?);
}

/// The transactional API: authorizes and dispatches.
async fn postmarkApi(ctx: borrow WebContext, request: borrow Request) -> Result<Response, AllocError> {
    match (await postmarkRefusal(ctx, request)?) {
        Some(r) => { return Ok(r); }
        null => {}
    }
    let path = request.path.view();
    let count = segmentCount(path);
    let area = segment(path, 1) ?? "";
    let second = segment(path, 2) ?? "";
    if (area.equalsIgnoreAsciiCase("email") && count == 2) {
        if (!request.isMethod("POST")) {
            return notAllowed("POST");
        }
        return await sendEmail(ctx, request);
    }
    if (area.equalsIgnoreAsciiCase("templates")) {
        if (count == 2) {
            if (request.isMethod("GET")) {
                return await listTemplates(ctx, request);
            }
            if (request.isMethod("POST")) {
                return await createTemplate(ctx, request);
            }
            return notAllowed("GET, POST");
        }
        if (count == 3 && second.equalsIgnoreAsciiCase("batch-send")) {
            if (!request.isMethod("POST")) {
                return notAllowed("POST");
            }
            return await batchSend(ctx, request);
        }
        if (count == 3) {
            let id = match (second.parseInt<i64>()) {
                Some(i) => i,
                null => { return Response.error(404, "No such endpoint."); }
            };
            if (request.isMethod("GET")) {
                return await templateAnswer(ctx, sqlGetTemplate(), id);
            }
            if (request.isMethod("PUT")) {
                return await updateTemplate(ctx, request, id);
            }
            if (request.isMethod("DELETE")) {
                return await templateAnswer(ctx, sqlDeleteTemplate(), id);
            }
            return notAllowed("GET, PUT, DELETE");
        }
        if (count == 4 && (segment(path, 3) ?? "").equalsIgnoreAsciiCase("send")) {
            if (!request.isMethod("POST")) {
                return notAllowed("POST");
            }
            var idOrName = String.create();
            percentDecode(second, false, mut idOrName)?;
            return await sendWithTemplate(ctx, request, idOrName.view());
        }
    }
    if (area.equalsIgnoreAsciiCase("messages") && count == 4) {
        let what = segment(path, 3) ?? "";
        if (!request.isMethod("GET")) {
            return notAllowed("GET");
        }
        var id = String.create();
        percentDecode(second, false, mut id)?;
        var params = PgParams.create();
        if (!bound(params.text(id.view()))) {
            return Err(AllocError.OutOfMemory);
        }
        if (what.equalsIgnoreAsciiCase("events")) {
            return await answer(ctx, sqlMessageEvents(), params, "");
        }
        if (what.equalsIgnoreAsciiCase("status")) {
            return await answer(ctx, sqlMessageStatus(), params, "Message not found");
        }
    }
    if (area.equalsIgnoreAsciiCase("suppressions") && count == 2) {
        if (request.isMethod("GET")) {
            return await listSuppressions(ctx, request);
        }
        if (request.isMethod("POST") || request.isMethod("DELETE")) {
            return await changeSuppression(ctx, request, request.isMethod("POST"));
        }
        return notAllowed("GET, POST, DELETE");
    }
    return Response.error(404, "No such endpoint.");
}

/// The answer to a call without the right token, or null when it has it.
async fn postmarkRefusal(ctx: borrow WebContext, request: borrow Request) -> Result<Response?, AllocError> {
    let given = match (request.header("X-Postmark-Server-Token")) {
        Some(v) => v.view(),
        null => { return Ok(pmError(401, 10, "Missing API Token")?); }
    };
    let expected = ctx.admin.postmarkToken.view();
    if (expected.length == 0) {
        return Ok(pmError(503, 503, "Postmark token is not configured")?);
    }
    let mail = ctx.mail.get();
    if (await loginBlocked(mail.login, mail.store, request.peer)) {
        return Ok(pmError(429, 429, "Too many failed attempts from your address; try again later.")?);
    }
    if (!constantTimeEqual(given.bytes(), expected.bytes())) {
        let blocked = await loginFailed(mail.login, mail.store, request.peer, "postmark-api".bytes());
        return Ok(pmError(401, 10, "Invalid API Token")?);
    }
    return Ok(null);
}

// ---- Reading requests ----

/// The member of `object` named `name` in any case (the last, if it repeats).
fn pmMember(doc: borrow JsonDocument, object: usize, name: StringView) -> Result<usize?, AllocError> {
    var keys = Vector<usize>.create();
    doc.keys(object, mut keys)?;
    var found: usize? = null;
    var key = String.create();
    for (k in keys.view()) {
        if (doc.string(k, mut key)? && key.view().equalsIgnoreAsciiCase(name)) {
            found = doc.valueOf(k);
        }
    }
    return Ok(found);
}

/// The string member `name` of `object` into `into`; false when it is absent, null, or not a string.
fn pmText(
    doc: borrow JsonDocument,
    object: usize,
    name: StringView,
    into: borrow mut String,
) -> Result<bool, AllocError> {
    into.clear();
    match (pmMember(doc, object, name)?) {
        Some(v) => { return doc.string(v, into); }
        null => { return Ok(false); }
    }
}

/// The request body as a JSON object, or null.
fn pmBody(request: borrow Request) -> JsonDocument? {
    let doc = match (JsonDocument.parse(request.body.view())) {
        Ok(d) => d,
        Err(_) => { return null; }
    };
    return match (doc.kind(doc.root())) {
        JsonKind.Object => doc,
        _ => null,
    };
}

/// Binds `value` when `present`, else NULL.
fn bindOptional(params: borrow mut PgParams, present: bool, value: StringView) -> bool {
    if (present) {
        return bound(params.text(value));
    }
    return bound(params.sqlNull());
}

/// $1 name: the domain's id, or no row.
fn sqlDomainByName() -> StringView => "SELECT id FROM domains WHERE name = lower(btrim($1))";

/// The id of the domain `name`; 0 when there is none, -1 when the database cannot say.
async fn domainNamed(ctx: borrow WebContext, name: StringView) -> Result<i64, AllocError> {
    if (name.trim().length == 0) {
        return Ok(0);
    }
    var params = PgParams.create();
    if (!bound(params.text(name))) {
        return Err(AllocError.OutOfMemory);
    }
    var rows = PgRows.create();
    if (!(await queryRows(ctx, sqlDomainByName(), params, mut rows))) {
        return Ok(-1);
    }
    return Ok(if (rows.rowCount() == 0) 0 else rows.int64(0, 0) ?? 0);
}

/// The domain of the address `address` (after its last @).
fn domainOfAddress(address: StringView) -> StringView => match (address.lastIndexOf("@")) {
    Some(at) => address[at + 1..],
    null => "",
};

/// `offset` and `limit` from the query: limit 1 to 500, 50 when absent, as the C# server clamped them.
fn pmPage(request: borrow Request) -> Result<[i64; 2], AllocError> {
    var text = String.create();
    let offset = if (request.param("offset", mut text)?) text.view().parseInt<i64>() ?? 0 else 0;
    let limit = if (request.param("limit", mut text)?) text.view().parseInt<i64>() ?? 50 else 50;
    return Ok([if (offset < 0) 0 else offset, if (limit < 1) 1 else if (limit > 500) 500 else limit]);
}

// ---- Templates ----

/// A template's JSON, from the row `t`.
fn templateJson() -> StringView =>
    """
    jsonb_build_object('id', t.id, 'domainId', t.domain_id, 'name', t.name, 'subject', t.subject,
        'htmlBody', t.html_body, 'textBody', t.text_body, 'active', t.active, 'createdAt', t.created_at,
        'updatedAt', t.updated_at)::text
    """;

/// $1 domain, $2 name, $3 subject, $4 HTML body, $5 text body (NULL when absent).
fn sqlCreateTemplate() -> StringView =>
    """
    INSERT INTO email_templates AS t (domain_id, name, subject, html_body, text_body)
    VALUES ($1, $2, $3::text, $4::text, $5::text)
    RETURNING 200,
        jsonb_build_object('id', t.id, 'domainId', t.domain_id, 'name', t.name, 'subject', t.subject,
            'htmlBody', t.html_body, 'textBody', t.text_body, 'active', t.active, 'createdAt', t.created_at,
            'updatedAt', t.updated_at)::text
    """;

/// $1 id, then name, subject, HTML body, text body, active: NULL keeps a value.
fn sqlUpdateTemplate() -> StringView =>
    """
    UPDATE email_templates AS t SET name = coalesce($2::text, name), subject = coalesce($3::text, subject),
        html_body = coalesce($4::text, html_body), text_body = coalesce($5::text, text_body),
        active = coalesce($6::boolean, active), updated_at = now()
    WHERE id = $1
    RETURNING 200,
        jsonb_build_object('id', t.id, 'domainId', t.domain_id, 'name', t.name, 'subject', t.subject,
            'htmlBody', t.html_body, 'textBody', t.text_body, 'active', t.active, 'createdAt', t.created_at,
            'updatedAt', t.updated_at)::text
    """;

/// $1 id.
fn sqlGetTemplate() -> StringView =>
    """
    SELECT 200,
        jsonb_build_object('id', t.id, 'domainId', t.domain_id, 'name', t.name, 'subject', t.subject,
            'htmlBody', t.html_body, 'textBody', t.text_body, 'active', t.active, 'createdAt', t.created_at,
            'updatedAt', t.updated_at)::text
    FROM email_templates t WHERE t.id = $1
    """;

/// $1 id. 204 whether or not it was there, as the C# server answered.
fn sqlDeleteTemplate() -> StringView =>
    """
    WITH gone AS (DELETE FROM email_templates WHERE id = $1) SELECT 204, ''
    """;

/// $1 domain, $2 offset, $3 limit.
fn sqlListTemplates() -> StringView =>
    """
    SELECT 200, coalesce(jsonb_agg(j ORDER BY id), '[]')::text FROM (
        SELECT t.id, jsonb_build_object('id', t.id, 'domainId', t.domain_id, 'name', t.name, 'subject', t.subject,
            'htmlBody', t.html_body, 'textBody', t.text_body, 'active', t.active, 'createdAt', t.created_at,
            'updatedAt', t.updated_at) AS j
        FROM email_templates t WHERE t.domain_id = $1 ORDER BY t.id OFFSET $2 LIMIT $3) s
    """;

async fn templateAnswer(ctx: borrow WebContext, sql: StringView, id: i64) -> Result<Response, AllocError> {
    var params = PgParams.create();
    if (!bound(params.int64(id))) {
        return Err(AllocError.OutOfMemory);
    }
    return await answer(ctx, sql, params, "Template not found");
}

/// POST /postmark/templates: {name, domainName, subject, htmlBody, textBody}.
async fn createTemplate(ctx: borrow WebContext, request: borrow Request) -> Result<Response, AllocError> {
    let doc = match (pmBody(request)) {
        Some(d) => d,
        null => { return Response.error(400, "A JSON object is required."); }
    };
    let root = doc.root();
    var domain = String.create();
    pmText(doc, root, "domainName", mut domain)?;
    let domainId = await domainNamed(ctx, domain.view())?;
    if (domainId < 0) {
        return Response.error(503, "The database is not available.");
    }
    if (domainId == 0) {
        return Response.error(400, "Domain not found");
    }
    var name = String.create();
    pmText(doc, root, "name", mut name)?;
    if (name.view().trim().length == 0 || name.length > 256) {
        return Response.error(400, "A name of 1 to 256 characters is required");
    }
    var subject = String.create();
    var html = String.create();
    var text = String.create();
    let hasSubject = pmText(doc, root, "subject", mut subject)?;
    let hasHtml = pmText(doc, root, "htmlBody", mut html)?;
    let hasText = pmText(doc, root, "textBody", mut text)?;
    var params = PgParams.create();
    let ok = bound(params.int64(domainId)) && bound(params.text(name.view().trim())) &&
        bindOptional(mut params, hasSubject, subject.view()) && bindOptional(mut params, hasHtml, html.view()) &&
        bindOptional(mut params, hasText, text.view());
    if (!ok) {
        return Err(AllocError.OutOfMemory);
    }
    return await answer(ctx, sqlCreateTemplate(), params, "");
}

/// PUT /postmark/templates/{id}: the members given replace the template's; `active` turns it on or off.
async fn updateTemplate(ctx: borrow WebContext, request: borrow Request, id: i64) -> Result<Response, AllocError> {
    let doc = match (pmBody(request)) {
        Some(d) => d,
        null => { return Response.error(400, "A JSON object is required."); }
    };
    let root = doc.root();
    var name = String.create();
    var subject = String.create();
    var html = String.create();
    var text = String.create();
    let hasName = pmText(doc, root, "name", mut name)? && name.view().trim().length > 0;
    if (name.length > 256) {
        return Response.error(400, "A name of 1 to 256 characters is required");
    }
    let hasSubject = pmText(doc, root, "subject", mut subject)?;
    let hasHtml = pmText(doc, root, "htmlBody", mut html)?;
    let hasText = pmText(doc, root, "textBody", mut text)?;
    var params = PgParams.create();
    var ok = bound(params.int64(id)) && bindOptional(mut params, hasName, name.view().trim()) &&
        bindOptional(mut params, hasSubject, subject.view()) && bindOptional(mut params, hasHtml, html.view()) &&
        bindOptional(mut params, hasText, text.view());
    let active = match (pmMember(doc, root, "active")?) {
        Some(v) => doc.boolean(v),
        null => null,
    };
    ok = ok && match (active) {
        Some(a) => bound(params.bool(a)),
        null => bound(params.sqlNull()),
    };
    if (!ok) {
        return Err(AllocError.OutOfMemory);
    }
    return await answer(ctx, sqlUpdateTemplate(), params, "Template not found");
}

/// GET /postmark/templates?domain=&offset=&limit=.
async fn listTemplates(ctx: borrow WebContext, request: borrow Request) -> Result<Response, AllocError> {
    var domain = String.create();
    if (!(request.param("domain", mut domain)?) || domain.view().trim().length == 0) {
        return Response.error(400, "domain query parameter required");
    }
    let domainId = await domainNamed(ctx, domain.view())?;
    if (domainId < 0) {
        return Response.error(503, "The database is not available.");
    }
    if (domainId == 0) {
        return Response.error(404, "Domain not found");
    }
    let page = pmPage(request)?;
    var params = PgParams.create();
    if (!(bound(params.int64(domainId)) && bound(params.int64(page[0])) && bound(params.int64(page[1])))) {
        return Err(AllocError.OutOfMemory);
    }
    return await answer(ctx, sqlListTemplates(), params, "");
}

/// $1 domain, $2 id (0 for none), $3 name: an active or inactive template's subject, bodies and whether it is active.
fn sqlTemplateForSend() -> StringView =>
    """
    SELECT subject, html_body, text_body, active FROM email_templates
    WHERE domain_id = $1 AND (id = $2 OR ($2 = 0 AND name = $3))
    """;

/// A template to send: its parts (null when absent).
@noncopy
struct SendTemplate {
    subject: String;
    hasSubject: bool;
    html: String;
    hasHtml: bool;
    text: String;
    hasText: bool;
}

/// The domain's active template, by id when `idOrName` is a number, else by name, into `into`: FOUND_YES,
/// FOUND_NONE (none, or inactive), or FOUND_UNAVAILABLE when the database cannot say.
async fn templateForSend(
    ctx: borrow WebContext,
    domainId: i64,
    idOrName: StringView,
    into: borrow mut SendTemplate,
) -> Result<u8, AllocError> {
    var params = PgParams.create();
    let id = idOrName.parseInt<i64>() ?? 0;
    if (!(bound(params.int64(domainId)) && bound(params.int64(id)) && bound(params.text(idOrName)))) {
        return Err(AllocError.OutOfMemory);
    }
    var rows = PgRows.create();
    if (!(await queryRows(ctx, sqlTemplateForSend(), params, mut rows))) {
        return Ok(FOUND_UNAVAILABLE);
    }
    if (rows.rowCount() == 0 || !(rows.bool(0, 3) ?? false)) {
        return Ok(FOUND_NONE);
    }
    match (rows.text(0, 0)) {
        Some(s) => {
            into.subject.append(s)?;
            into.hasSubject = true;
        }
        null => {}
    }
    match (rows.text(0, 1)) {
        Some(s) => {
            into.html.append(s)?;
            into.hasHtml = true;
        }
        null => {}
    }
    match (rows.text(0, 2)) {
        Some(s) => {
            into.text.append(s)?;
            into.hasText = true;
        }
        null => {}
    }
    return Ok(FOUND_YES);
}

const FOUND_YES: u8 = 0;
const FOUND_NONE: u8 = 1;
const FOUND_UNAVAILABLE: u8 = 2;

/// Renders `template`'s parts into `mail` with the model `model` (an object node of `doc`), or an empty model.
fn renderTemplate(
    template: borrow SendTemplate,
    doc: borrow JsonDocument,
    model: usize?,
    mail: borrow mut OutgoingMail,
) -> Result<void, AllocError> {
    mail.subject.clear();
    mail.html.clear();
    mail.text.clear();
    let empty = match (JsonDocument.parse("{}".bytes())) {
        Ok(d) => d,
        Err(_) => { return Err(AllocError.OutOfMemory); }
    };
    let useModel = match (model) {
        Some(m) => match (doc.kind(m)) {
            JsonKind.Object => true,
            _ => false,
        },
        null => false,
    };
    let node = model ?? 0;
    if (template.hasSubject) {
        if (useModel) {
            renderLiquid(template.subject.view(), doc, node, mut mail.subject)?;
        } else {
            renderLiquid(template.subject.view(), empty, 0, mut mail.subject)?;
        }
    }
    mail.hasHtml = template.hasHtml;
    if (template.hasHtml) {
        if (useModel) {
            renderLiquid(template.html.view(), doc, node, mut mail.html)?;
        } else {
            renderLiquid(template.html.view(), empty, 0, mut mail.html)?;
        }
    }
    mail.hasText = template.hasText;
    if (template.hasText) {
        if (useModel) {
            renderLiquid(template.text.view(), doc, node, mut mail.text)?;
        } else {
            renderLiquid(template.text.view(), empty, 0, mut mail.text)?;
        }
    }
    return Ok();
}

// ---- Sending ----

/// What became of a send's attachments.
enum Attached {
    Fine,
    TooLarge,
    Invalid,
}

/// Reads `Attachments` (Name, Content in base64, ContentType) into `mail`.
fn readAttachments(
    doc: borrow JsonDocument,
    object: usize,
    mail: borrow mut OutgoingMail,
) -> Result<Attached, AllocError> {
    let list = match (pmMember(doc, object, "attachments")?) {
        Some(l) => l,
        null => { return Ok(Attached.Fine); }
    };
    match (doc.kind(list)) {
        JsonKind.Null => { return Ok(Attached.Fine); }
        JsonKind.Array => {}
        _ => { return Ok(Attached.Invalid); }
    }
    var items = Vector<usize>.create();
    doc.items(list, mut items)?;
    // The C# server's estimate first, before decoding anything.
    var estimate: usize = 0;
    var content = String.create();
    for (item in items.view()) {
        if (pmText(doc, item, "content", mut content)?) {
            estimate += content.length / 4 * 3;
        }
    }
    if (estimate > PM_MAX_ATTACHMENTS) {
        return Ok(Attached.TooLarge);
    }
    var name = String.create();
    var kind = String.create();
    for (item in items.view()) {
        if (!(pmText(doc, item, "content", mut content)?)) {
            continue;
        }
        var a = MailAttachment {
            name: Vector<u8>.create(),
            contentType: Vector<u8>.create(),
            data: Vector<u8>.create(),
        };
        match (Base64.decodeIgnoringSpace(content.view().bytes(), mut a.data)) {
            Ok() => {}
            Err(encoding.DecodeError.OutOfMemory) => { return Err(AllocError.OutOfMemory); }
            Err(_) => { return Ok(Attached.Invalid); }
        }
        if (pmText(doc, item, "name", mut name)?) {
            a.name.extend(name.view().bytes())?;
        }
        if (pmText(doc, item, "contentType", mut kind)? && kind.view().trim().length > 0) {
            if (!isMediaType(kind.view().trim().bytes())) {
                return Ok(Attached.Invalid);
            }
            a.contentType.extend(kind.view().trim().bytes())?;
        } else {
            a.contentType.extend("application/octet-stream".bytes())?;
        }
        mail.attachments.push(a)?;
    }
    return Ok(Attached.Fine);
}

/// A new message id: a random UUID (version 4), as Postmark's MessageID.
fn newMessageId(into: borrow mut String) -> Result<void, AllocError> {
    var random = [0u8; 16];
    match (Random.fill(mut random[..])) {
        Ok() => {}
        Err(_) => {}
    }
    random[6] = (random[6] & 0x0f) | 0x40;
    random[8] = (random[8] & 0x3f) | 0x80;
    var hex = Vector<u8>.create();
    Hex.encode(random[..], mut hex)?;
    let h = StringView.fromUtf8(hex.view()) ?? "";
    into.clear();
    into.append(h[0..8])?;
    into.append("-")?;
    into.append(h[8..12])?;
    into.append("-")?;
    into.append(h[12..16])?;
    into.append("-")?;
    into.append(h[16..20])?;
    into.append("-")?;
    return into.append(h[20..32]);
}

fn pmWriteBlob(blobs: borrow BlobStore, content: Slice<u8>) -> Result<BlobWriter, StoreError> {
    var writer = blobs.begin()?;
    match (writer.write(content)) {
        Ok() => {}
        Err(e) => {
            writer.discard();
            return Err(e);
        }
    }
    match (writer.finish()) {
        Ok() => {}
        Err(e) => {
            writer.discard();
            return Err(e);
        }
    }
    return Ok(writer);
}

/// Composes `mail` and sends it from `sender` to `recipients`: local users' inboxes now, the queue for the rest. Its
/// events go under `messageId`. False when the store could not take it.
async fn deliverMail(
    ctx: borrow WebContext,
    mail: borrow mut OutgoingMail,
    sender: StringView,
    recipients: borrow Vector<String>,
    messageId: StringView,
) -> Result<bool, AllocError> {
    mail.messageId.clear();
    mail.messageId.push(0x3c)?;
    mail.messageId.extend(messageId.bytes())?;
    mail.messageId.push(0x40)?;
    mail.messageId.extend(domainOfAddress(sender).bytes())?;
    mail.messageId.push(0x3e)?;
    mail.date = Clock.unixMillis() / 1000;
    var random = [0u8; 12];
    match (Random.fill(mut random[..])) {
        Ok() => {}
        Err(_) => {}
    }
    var boundary = Vector<u8>.create();
    Hex.encode(random[..], mut boundary)?;
    var message = Vector<u8>.create();
    composeMail(mail, boundary.view(), mut message)?;
    let store = borrow ctx.mail.get().store;
    var scanner = MimeScanner.create();
    scanner.feed(message.view())?;
    var index = MessageIndex.create();
    scanner.finish(mut index)?;
    var renderer = Renderer.create();
    var meta = Vector<u8>.create();
    encodeMeta(index, mut renderer, mut meta)?;
    let now = Clock.unixMillis();
    var targets = Vector<Delivery>.create();
    var outbound = Outbound.create();
    var users = Vector<i64>.create();
    var locals = Vector<String>.create();
    var unknown = Vector<String>.create();
    for (a in recipients.view()) {
        var to = Recipient.create();
        match (await store.resolve(a.view(), mut to)) {
            Ok() => {}
            Err(_) => { return Ok(false); }
        }
        if (to.isUser() && to.inboxId != 0) {
            var known = false;
            for (u in users.view()) {
                if (u == to.userId) {
                    known = true;
                }
            }
            if (!known) {
                users.push(to.userId)?;
                var d = Delivery.to(to.userId, to.inboxId, now);
                d.meta.extend(meta.view())?;
                targets.push(d)?;
            }
            var r = String.create();
            r.append(a.view())?;
            locals.push(r)?;
        } else if (to.isRemote() || to.isNotLocal()) {
            var r = String.create();
            r.append(if (to.isRemote()) to.address.view() else a.view())?;
            outbound.recipients.push(r)?;
        } else {
            var r = String.create();
            r.append(a.view())?;
            unknown.push(r)?;
        }
    }
    outbound.sender.append(sender)?;
    outbound.messageId.append(messageId)?;
    let blobs = store.blobs();
    let bytes = message.view();
    let made: Result<BlobWriter, StoreError> = await Async.blocking(() => pmWriteBlob(blobs, bytes));
    var writer = match (made) {
        Ok(w) => w,
        Err(StoreError.OutOfMemory) => { return Err(AllocError.OutOfMemory); }
        Err(_) => { return Ok(false); }
    };
    var done = Vector<Delivered>.create();
    match (await store.accept(mut writer, targets, outbound, mut done)) {
        Ok(_) => {}
        Err(StoreError.OutOfMemory) => { return Err(AllocError.OutOfMemory); }
        Err(_) => { return Ok(false); }
    }
    // Events: "queued" came with the queue row when there are remote recipients; local ones are delivered already.
    if (outbound.recipients.length == 0) {
        await recordEvent(ctx, messageId, "queued", "");
    }
    for (l in locals.view()) {
        await recordEvent(ctx, messageId, "sent", l.view());
    }
    for (u in unknown.view()) {
        var details = String.create();
        details.append(u.view())?;
        details.append(": 550 5.1.1 No such user here")?;
        await recordEvent(ctx, messageId, "failed", details.view());
    }
    if (outbound.recipients.length == 0 && unknown.length == 0) {
        await recordEvent(ctx, messageId, "delivered", "");
    }
    return Ok(true);
}

async fn recordEvent(ctx: borrow WebContext, messageId: StringView, kind: StringView, details: StringView) {
    match (await ctx.mail.get().store.messageEvent(messageId, kind, details)) {
        Ok() => {}
        Err(_) => {}
    }
}

/// $1 domain, $2 address: whether the domain's list suppresses it.
fn sqlSuppressed() -> StringView =>
    "SELECT 1 FROM suppression_list WHERE domain_id = $1 AND email = lower(btrim($2))";

/// The index of the first of `addresses` the domain suppresses: -1 when none is, -2 when the database cannot say.
async fn firstSuppressed(
    ctx: borrow WebContext,
    domainId: i64,
    addresses: borrow Vector<String>,
) -> Result<i64, AllocError> {
    for (i in 0..addresses.length) {
        var params = PgParams.create();
        if (!(bound(params.int64(domainId)) && bound(params.text(addresses[i].view())))) {
            return Err(AllocError.OutOfMemory);
        }
        var rows = PgRows.create();
        if (!(await queryRows(ctx, sqlSuppressed(), params, mut rows))) {
            return Ok(-2);
        }
        if (rows.rowCount() > 0) {
            return Ok(truncate<i64>(i));
        }
    }
    return Ok(-1);
}

/// The success answer of a send.
fn sentAnswer(to: StringView, messageId: StringView) -> Result<Response, AllocError> {
    var w = JsonWriter.create();
    w.beginObject();
    w.stringField("to", to);
    var time = Vector<u8>.create();
    appendIsoTime(mut time, Clock.unixMillis() / 1000)?;
    w.key("submittedAt");
    w.stringBytes(time.view());
    w.stringField("messageID", messageId);
    w.integerField("errorCode", 0);
    w.stringField("message", "OK");
    w.endObject();
    return Response.json(200, w.finish()?);
}

/// The sender's address from `From` (one mailbox), into `into`; false when it is not one.
fn senderOf(from: StringView, into: borrow mut String) -> Result<bool, AllocError> {
    var list = Vector<String>.create();
    if (!(addressesOf(from.bytes(), mut list)?) || list.length != 1) {
        return Ok(false);
    }
    into.clear();
    into.append(list[0].view())?;
    return Ok(true);
}

/// POST /postmark/email: From, To, Cc, Bcc, ReplyTo, Subject, Tag, HtmlBody, TextBody, Attachments.
async fn sendEmail(ctx: borrow WebContext, request: borrow Request) -> Result<Response, AllocError> {
    let doc = match (pmBody(request)) {
        Some(d) => d,
        null => { return pmError(400, 400, "A JSON object is required."); }
    };
    let root = doc.root();
    var from = String.create();
    if (!(pmText(doc, root, "from", mut from)?) || from.view().trim().length == 0) {
        return Response.text(400, "Missing From address");
    }
    var sender = String.create();
    if (!(senderOf(from.view(), mut sender)?)) {
        return pmError(400, 300, "Invalid 'From' address.");
    }
    let domainId = await domainNamed(ctx, domainOfAddress(sender.view()))?;
    if (domainId < 0) {
        return pmError(503, 503, "The database is not available.");
    }
    if (domainId == 0) {
        return Response.text(401, "Domain not configured on this server");
    }
    var mail = OutgoingMail.create();
    mail.from.extend(from.view().bytes())?;
    var recipients = Vector<String>.create();
    var value = String.create();
    if (pmText(doc, root, "to", mut value)? && value.view().trim().length > 0) {
        if (!(addressesOf(value.view().bytes(), mut recipients)?)) {
            return pmError(400, 300, "Invalid 'To' address.");
        }
        mail.to.extend(value.view().bytes())?;
    }
    if (pmText(doc, root, "cc", mut value)? && value.view().trim().length > 0) {
        if (!(addressesOf(value.view().bytes(), mut recipients)?)) {
            return pmError(400, 300, "Invalid 'Cc' address.");
        }
        mail.cc.extend(value.view().bytes())?;
    }
    if (pmText(doc, root, "bcc", mut value)? && value.view().trim().length > 0) {
        if (!(addressesOf(value.view().bytes(), mut recipients)?)) {
            return pmError(400, 300, "Invalid 'Bcc' address.");
        }
    }
    if (recipients.length == 0) {
        return pmError(400, 300, "Provide at least one recipient.");
    }
    if (recipients.length > PM_MAX_RECIPIENTS) {
        return pmError(400, 300, "At most 50 recipients (To, Cc and Bcc).");
    }
    if (pmText(doc, root, "replyTo", mut value)? && value.view().trim().length > 0) {
        var replies = Vector<String>.create();
        if (!(addressesOf(value.view().bytes(), mut replies)?)) {
            return pmError(400, 300, "Invalid 'ReplyTo' address.");
        }
        mail.replyTo.extend(value.view().bytes())?;
    }
    let suppressed = await firstSuppressed(ctx, domainId, recipients)?;
    if (suppressed == -2) {
        return pmError(503, 503, "The database is not available.");
    }
    if (suppressed >= 0) {
        var w = JsonWriter.create();
        w.beginObject();
        w.integerField("errorCode", 406);
        w.stringField("message", "Recipient is suppressed");
        w.stringField("email", recipients[truncate<usize>(suppressed)].view());
        w.endObject();
        return Response.json(406, w.finish()?);
    }
    match (readAttachments(doc, root, mut mail)?) {
        Attached.TooLarge => { return pmError(413, 413, "Total attachment size exceeds 25 MB limit"); }
        Attached.Invalid => {
            return pmError(400, 300, "Invalid attachment: Content must be base64, ContentType a media type.");
        }
        _ => {}
    }
    if (pmText(doc, root, "subject", mut value)?) {
        mail.subject.extend(value.view().bytes())?;
    }
    if (pmText(doc, root, "tag", mut value)?) {
        mail.tag.extend(value.view().bytes())?;
    }
    if (pmText(doc, root, "htmlBody", mut value)? && value.length > 0) {
        mail.html.extend(value.view().bytes())?;
        mail.hasHtml = true;
    }
    if (pmText(doc, root, "textBody", mut value)? && value.length > 0) {
        mail.text.extend(value.view().bytes())?;
        mail.hasText = true;
    }
    var messageId = String.create();
    newMessageId(mut messageId)?;
    if (!(await deliverMail(ctx, mut mail, sender.view(), recipients, messageId.view())?)) {
        return pmError(500, 500, "The message could not be queued.");
    }
    var to = String.create();
    pmText(doc, root, "to", mut to)?;
    return sentAnswer(to.view(), messageId.view());
}

/// POST /postmark/templates/{idOrName}/send: From, To, Tag, TemplateModel, Attachments.
async fn sendWithTemplate(
    ctx: borrow WebContext,
    request: borrow Request,
    idOrName: StringView,
) -> Result<Response, AllocError> {
    let doc = match (pmBody(request)) {
        Some(d) => d,
        null => { return Response.error(400, "From and To are required"); }
    };
    let root = doc.root();
    var from = String.create();
    var to = String.create();
    pmText(doc, root, "from", mut from)?;
    pmText(doc, root, "to", mut to)?;
    if (from.view().trim().length == 0 || to.view().trim().length == 0) {
        return Response.error(400, "From and To are required");
    }
    var sender = String.create();
    if (!(senderOf(from.view(), mut sender)?)) {
        return Response.error(400, "Invalid From address");
    }
    var recipients = Vector<String>.create();
    if (!(addressesOf(to.view().bytes(), mut recipients)?) || recipients.length > PM_MAX_RECIPIENTS) {
        return Response.error(400, "Invalid To address");
    }
    let domainId = await domainNamed(ctx, domainOfAddress(sender.view()))?;
    if (domainId < 0) {
        return Response.error(503, "The database is not available.");
    }
    if (domainId == 0) {
        return Response.error(401, "Sender domain not configured");
    }
    var template = SendTemplate {
        subject: String.create(),
        hasSubject: false,
        html: String.create(),
        hasHtml: false,
        text: String.create(),
        hasText: false,
    };
    let found = await templateForSend(ctx, domainId, idOrName, mut template)?;
    if (found == FOUND_UNAVAILABLE) {
        return Response.error(503, "The database is not available.");
    }
    if (found == FOUND_NONE) {
        return Response.error(404, "Template not found or inactive");
    }
    let suppressed = await firstSuppressed(ctx, domainId, recipients)?;
    if (suppressed == -2) {
        return Response.error(503, "The database is not available.");
    }
    if (suppressed >= 0) {
        return pmRefused(422, "Recipient is suppressed", recipients[truncate<usize>(suppressed)].view());
    }
    var mail = OutgoingMail.create();
    match (readAttachments(doc, root, mut mail)?) {
        Attached.TooLarge => { return Response.error(413, "Total attachment size exceeds 25 MB limit"); }
        Attached.Invalid => {
            return Response.error(400, "Invalid attachment: Content must be base64, ContentType a media type.");
        }
        _ => {}
    }
    mail.from.extend(from.view().bytes())?;
    mail.to.extend(to.view().bytes())?;
    var tag = String.create();
    if (pmText(doc, root, "tag", mut tag)?) {
        mail.tag.extend(tag.view().bytes())?;
    }
    renderTemplate(template, doc, pmMember(doc, root, "templateModel")?, mut mail)?;
    var messageId = String.create();
    newMessageId(mut messageId)?;
    if (!(await deliverMail(ctx, mut mail, sender.view(), recipients, messageId.view())?)) {
        return Response.error(500, "The message could not be queued.");
    }
    return sentAnswer(to.view(), messageId.view());
}

/// POST /postmark/templates/batch-send: From, TemplateName, Tag, Attachments, and Recipients (each To and
/// TemplateModel), at most 500. Each recipient gets its own message; the answer lists each one's outcome.
async fn batchSend(ctx: borrow WebContext, request: borrow Request) -> Result<Response, AllocError> {
    let doc = match (pmBody(request)) {
        Some(d) => d,
        null => { return Response.error(400, "From and TemplateName are required"); }
    };
    let root = doc.root();
    var from = String.create();
    var templateName = String.create();
    pmText(doc, root, "from", mut from)?;
    pmText(doc, root, "templateName", mut templateName)?;
    if (from.view().trim().length == 0 || templateName.view().trim().length == 0) {
        return Response.error(400, "From and TemplateName are required");
    }
    var list = Vector<usize>.create();
    match (pmMember(doc, root, "recipients")?) {
        Some(r) => { doc.items(r, mut list)?; }
        null => {}
    }
    if (list.length == 0) {
        return Response.error(400, "Recipients required");
    }
    if (list.length > PM_MAX_BATCH) {
        return Response.error(400, "Maximum 500 recipients per batch");
    }
    var sender = String.create();
    if (!(senderOf(from.view(), mut sender)?)) {
        return Response.error(400, "Invalid From address");
    }
    let domainId = await domainNamed(ctx, domainOfAddress(sender.view()))?;
    if (domainId < 0) {
        return Response.error(503, "The database is not available.");
    }
    if (domainId == 0) {
        return Response.error(401, "Sender domain not configured");
    }
    var template = SendTemplate {
        subject: String.create(),
        hasSubject: false,
        html: String.create(),
        hasHtml: false,
        text: String.create(),
        hasText: false,
    };
    // By name only, as the C# server looked it up (a numeric name is still a name here).
    let found = await templateByName(ctx, domainId, templateName.view(), mut template)?;
    if (found == FOUND_UNAVAILABLE) {
        return Response.error(503, "The database is not available.");
    }
    if (found == FOUND_NONE) {
        return Response.error(404, "Template not found or inactive");
    }
    var mail = OutgoingMail.create();
    match (readAttachments(doc, root, mut mail)?) {
        Attached.TooLarge => { return Response.error(413, "Total attachment size exceeds 25 MB limit"); }
        Attached.Invalid => {
            return Response.error(400, "Invalid attachment: Content must be base64, ContentType a media type.");
        }
        _ => {}
    }
    mail.from.extend(from.view().bytes())?;
    var tag = String.create();
    if (pmText(doc, root, "tag", mut tag)?) {
        mail.tag.extend(tag.view().bytes())?;
    }
    var w = JsonWriter.create();
    w.beginArray();
    var to = String.create();
    var messageId = String.create();
    for (item in list.view()) {
        pmText(doc, item, "to", mut to)?;
        var recipients = Vector<String>.create();
        if (to.view().trim().length == 0) {
            batchResult(mut w, to.view(), "", 400, "Missing To");
            continue;
        }
        if (!(addressesOf(to.view().bytes(), mut recipients)?) || recipients.length > PM_MAX_RECIPIENTS) {
            batchResult(mut w, to.view(), "", 400, "Invalid To");
            continue;
        }
        let suppressed = await firstSuppressed(ctx, domainId, recipients)?;
        if (suppressed >= 0) {
            batchResult(mut w, to.view(), "", 406, "Recipient suppressed");
            continue;
        }
        if (suppressed == -2) {
            batchResult(mut w, to.view(), "", 503, "The database is not available.");
            continue;
        }
        mail.to.clear();
        mail.to.extend(to.view().bytes())?;
        renderTemplate(template, doc, pmMember(doc, item, "templateModel")?, mut mail)?;
        newMessageId(mut messageId)?;
        if (await deliverMail(ctx, mut mail, sender.view(), recipients, messageId.view())?) {
            batchResult(mut w, to.view(), messageId.view(), 0, "OK");
        } else {
            batchResult(mut w, to.view(), "", 500, "The message could not be queued.");
        }
    }
    w.endArray();
    return Response.json(200, w.finish()?);
}

fn batchResult(w: borrow mut JsonWriter, to: StringView, messageId: StringView, code: i64, message: StringView) {
    w.beginObject();
    w.stringField("to", to);
    if (messageId.length > 0) {
        w.stringField("messageID", messageId);
    }
    w.integerField("errorCode", code);
    w.stringField("message", message);
    w.endObject();
}

/// The domain's active template named `name`.
async fn templateByName(
    ctx: borrow WebContext,
    domainId: i64,
    name: StringView,
    into: borrow mut SendTemplate,
) -> Result<u8, AllocError> {
    // By name even when it is a number: a batch names its template.
    var params = PgParams.create();
    if (!(bound(params.int64(domainId)) && bound(params.text(name)))) {
        return Err(AllocError.OutOfMemory);
    }
    var rows = PgRows.create();
    if (!(await queryRows(
        ctx,
        "SELECT subject, html_body, text_body, active FROM email_templates WHERE domain_id = $1 AND name = $2",
        params,
        mut rows,
    ))) {
        return Ok(FOUND_UNAVAILABLE);
    }
    if (rows.rowCount() == 0 || !(rows.bool(0, 3) ?? false)) {
        return Ok(FOUND_NONE);
    }
    match (rows.text(0, 0)) {
        Some(s) => {
            into.subject.append(s)?;
            into.hasSubject = true;
        }
        null => {}
    }
    match (rows.text(0, 1)) {
        Some(s) => {
            into.html.append(s)?;
            into.hasHtml = true;
        }
        null => {}
    }
    match (rows.text(0, 2)) {
        Some(s) => {
            into.text.append(s)?;
            into.hasText = true;
        }
        null => {}
    }
    return Ok(FOUND_YES);
}

// ---- Events ----

/// $1 message id: its events, oldest first.
fn sqlMessageEvents() -> StringView =>
    """
    SELECT 200, coalesce(jsonb_agg(jsonb_build_object('id', id, 'messageId', message_id, 'eventType', event_type,
        'details', details, 'createdAt', created_at) ORDER BY id), '[]')::text
    FROM message_events WHERE message_id = $1
    """;

/// $1 message id: its latest event.
fn sqlMessageStatus() -> StringView =>
    """
    SELECT 200, jsonb_build_object('messageId', message_id, 'status', event_type, 'timestamp', created_at,
        'details', details)::text
    FROM message_events WHERE message_id = $1 ORDER BY id DESC LIMIT 1
    """;

// ---- Suppressions ----

/// $1 domain, $2 offset, $3 limit.
fn sqlListSuppressions() -> StringView =>
    """
    SELECT 200, coalesce(jsonb_agg(j ORDER BY id), '[]')::text FROM (
        SELECT id, jsonb_build_object('id', id, 'domainId', domain_id, 'email', email, 'reason', reason,
            'createdAt', created_at) AS j
        FROM suppression_list WHERE domain_id = $1 ORDER BY id OFFSET $2 LIMIT $3) s
    """;

/// $1 domain, $2 address, $3 reason. Adding an address that is there already changes nothing.
fn sqlAddSuppression() -> StringView =>
    """
    WITH added AS (
        INSERT INTO suppression_list (domain_id, email, reason) VALUES ($1, lower(btrim($2)), $3)
        ON CONFLICT (domain_id, email) DO NOTHING)
    SELECT 200, '{"success":true}'
    """;

/// $1 domain, $2 address.
fn sqlRemoveSuppression() -> StringView =>
    """
    WITH gone AS (DELETE FROM suppression_list WHERE domain_id = $1 AND email = lower(btrim($2))) SELECT 204, ''
    """;

/// GET /postmark/suppressions?domain=&offset=&limit=.
async fn listSuppressions(ctx: borrow WebContext, request: borrow Request) -> Result<Response, AllocError> {
    var domain = String.create();
    if (!(request.param("domain", mut domain)?) || domain.view().trim().length == 0) {
        return Response.error(400, "domain query parameter required");
    }
    let domainId = await domainNamed(ctx, domain.view())?;
    if (domainId < 0) {
        return Response.error(503, "The database is not available.");
    }
    if (domainId == 0) {
        return Response.error(404, "Domain not found");
    }
    let page = pmPage(request)?;
    var params = PgParams.create();
    if (!(bound(params.int64(domainId)) && bound(params.int64(page[0])) && bound(params.int64(page[1])))) {
        return Err(AllocError.OutOfMemory);
    }
    return await answer(ctx, sqlListSuppressions(), params, "");
}

/// POST (add) and DELETE (remove) /postmark/suppressions: {domain, email, reason}.
async fn changeSuppression(ctx: borrow WebContext, request: borrow Request, add: bool) -> Result<Response, AllocError> {
    let doc = match (pmBody(request)) {
        Some(d) => d,
        null => { return Response.error(400, "A JSON object is required."); }
    };
    let root = doc.root();
    var domain = String.create();
    var email = String.create();
    var reason = String.create();
    pmText(doc, root, "domain", mut domain)?;
    pmText(doc, root, "email", mut email)?;
    let domainId = await domainNamed(ctx, domain.view())?;
    if (domainId < 0) {
        return Response.error(503, "The database is not available.");
    }
    if (domainId == 0) {
        return Response.error(404, "Domain not found");
    }
    if (email.view().trim().length == 0) {
        return Response.error(400, "email is required");
    }
    var params = PgParams.create();
    if (!(bound(params.int64(domainId)) && bound(params.text(email.view())))) {
        return Err(AllocError.OutOfMemory);
    }
    if (!add) {
        return await answer(ctx, sqlRemoveSuppression(), params, "");
    }
    if (!(pmText(doc, root, "reason", mut reason)?) || reason.length == 0) {
        reason.clear();
        reason.append("manual")?;
    }
    if (!bound(params.text(reason.view()))) {
        return Err(AllocError.OutOfMemory);
    }
    return await answer(ctx, sqlAddSuppression(), params, "");
}
