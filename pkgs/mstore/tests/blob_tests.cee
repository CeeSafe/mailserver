// The blob store on its own: no database needed.

import diskio.Files;
import encoding.Hex;

fn scratchRoot(name: StringView) -> String {
    var path = Directory.temporary()!;
    path.append("/mstore-blobs-")!;
    path.append(name)!;
    var tag = [0u8; 6];
    Random.fill(mut tag[..])!;
    var hex = Vector<u8>.create();
    Hex.encode(tag[..], mut hex)!;
    path.append(StringView.fromUtf8(hex.view())!)!;
    return path;
}

@test
fn hashesAndPlacesContent() -> Result<void, TestFailure> {
    let root = scratchRoot("place");
    var trailing = String.create();
    trailing.append(root.view())!;
    trailing.append("//")!;
    let store = BlobStore.create(trailing.view())!; // trailing slashes are dropped
    Check.isTrue(store.root() == root.view(), "root")?;
    var writer = store.begin()!;
    writer.write("a".bytes())!;
    writer.write("bc".bytes())!;
    writer.finish()!;
    Check.isTrue(writer.isFinished() && writer.size() == 3, "finished")?;
    var hex = Vector<u8>.create();
    Hex.encode(writer.hash(), mut hex)!;
    // SHA-256("abc"), FIPS 180-2.
    let expected = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
    Check.isTrue(hex.length == 64 && hex.view().startsWith(expected.bytes()), "hash")?;
    writer.place(store)!;
    var path = String.create();
    store.pathOf(writer.hash(), false, mut path)!;
    var want = String.create();
    want.append(root.view())!;
    want.append("/ba/78/")!;
    want.append(expected)!;
    Check.isTrue(path.view() == want.view(), "content-addressed path")?;
    let file = store.open(writer.hash())!;
    var back = [0u8; 8];
    Check.isTrue(file.readAt(mut back[..], 0)! == 3 && back[..].startsWith("abc".bytes()), "content")?;
    match (writer.write("more".bytes())) {
        Ok() => { return Check.fail("a finished writer took more"); }
        Err(_) => {}
    }
    return Ok();
}

@test
fn sweepsAbandonedWriters() -> Result<void, TestFailure> {
    let root = scratchRoot("sweep");
    let store = BlobStore.create(root.view())!;
    {
        var dropped = store.begin()!;
        dropped.write("left behind".bytes())!;
    }
    {
        var discarded = store.begin()!;
        discarded.write("removed now".bytes())!;
        discarded.discard();
    }
    var tmp = String.create();
    tmp.append(root.view())!;
    tmp.append("/tmp")!;
    Check.isTrue(Directory.list(tmp.view())!.length == 1, "a dropped writer leaves its file")?;
    Check.isTrue(store.sweepTemporary(3600)! == 0, "young files are kept")?;
    Check.isTrue(store.sweepTemporary(0)! == 1, "old files are swept")?;
    Check.isTrue(Directory.list(tmp.view())!.length == 0, "tmp is empty")?;
    let zeros = [0u8; 32];
    match (store.open(zeros[..])) {
        Ok(_) => { return Check.fail("opened a blob that was never written"); }
        Err(StoreError.File(_)) => {}
        Err(_) => { return Check.fail("wrong error for a missing blob"); }
    }
    let short = [0u8; 3];
    match (store.open(short[..])) {
        Ok(_) => { return Check.fail("opened a malformed hash"); }
        Err(StoreError.Invalid) => {}
        Err(_) => { return Check.fail("wrong error for a malformed hash"); }
    }
    Check.isTrue(Files.exists(tmp.view())!, "tmp stays")?;
    return Ok();
}

@test
fn buildsUidSets() -> Result<void, TestFailure> {
    var set = UidSet.create();
    Check.isTrue(set.isEmpty(), "empty")?;
    set.addRange(1, 3)!;
    set.add(7)!;
    set.addRange(10, 12)!;
    Check.isTrue(set.text() == "{[1,4),[7,8),[10,13)}", "multirange literal")?;
    match (set.addRange(5, 4)) {
        Ok() => { return Check.fail("a backwards range"); }
        Err(_) => {}
    }
    match (set.add(0)) {
        Ok() => { return Check.fail("uid 0"); }
        Err(_) => {}
    }
    set.clear();
    Check.isTrue(set.isEmpty() && set.text() == "", "cleared")?;
    return Ok();
}

fn accepted(name: StringView) -> bool => match (checkMailboxName(name)) {
    Ok() => true,
    Err(_) => false,
};

@test
fn checksMailboxNames() -> Result<void, TestFailure> {
    Check.isTrue(accepted("INBOX") && accepted("Work/2026") && accepted("Ünïcødé"), "good names")?;
    Check.isTrue(!accepted("") && !accepted("/a") && !accepted("a/") && !accepted("a//b"), "empty levels")?;
    return Check.isTrue(!accepted("tab\there") && !accepted("nul\u{0}"), "control characters");
}
