import diskio.FileError;
import postgres.PgConnection;
import postgres.PgError;
import postgres.PgErrors;
import postgres.PgParams;
import postgres.PgRows;

/// Why a store operation failed.
public enum StoreError {
    /// The database failed: unreachable, a broken connection, or a server error (see `MailStore` for the codes
    /// mapped to `Exists` and `NotFound`).
    Db(PgError),
    /// A blob file could not be written or read.
    File(FileError),
    /// The user, mailbox or message does not exist, or belongs to someone else.
    NotFound,
    /// A unique name is taken: a domain, address or mailbox name.
    Exists,
    /// An argument is malformed, such as a mailbox name or a blob hash of the wrong length.
    Invalid,
    OutOfMemory,
}

/// Words for `StoreError`s.
public struct StoreErrors {
    public fn describe(error: StoreError) -> StringView {
        match (error) {
            StoreError.Db(e) => { return PgErrors.describe(e); }
            StoreError.File(e) => { return diskio.describe(e); }
            StoreError.NotFound => { return "not found"; }
            StoreError.Exists => { return "already exists"; }
            StoreError.Invalid => { return "invalid argument"; }
            StoreError.OutOfMemory => { return "out of memory"; }
        }
    }
}

fn grown(outcome: Result<void, AllocError>) -> Result<void, StoreError> {
    match (outcome) {
        Ok() => { return Ok(); }
        Err(_) => { return Err(StoreError.OutOfMemory); }
    }
}

fn filed(outcome: Result<void, FileError>) -> Result<void, StoreError> {
    match (outcome) {
        Ok() => { return Ok(); }
        Err(e) => { return Err(StoreError.File(e)); }
    }
}

/// A database error as a store error: unique violations are `Exists`, foreign-key violations `NotFound`.
fn dbError(e: PgError, connection: borrow PgConnection) -> StoreError {
    match (e) {
        PgError.Server => {
            let code = connection.lastError().code();
            if (code == "23505") {
                return StoreError.Exists;
            }
            if (code == "23503") {
                return StoreError.NotFound;
            }
            return StoreError.Db(e);
        }
        PgError.OutOfMemory => { return StoreError.OutOfMemory; }
        _ => { return StoreError.Db(e); }
    }
}

fn plain(outcome: Result<void, PgError>) -> Result<void, StoreError> {
    match (outcome) {
        Ok() => { return Ok(); }
        Err(e) => { return Err(StoreError.Db(e)); }
    }
}

/// Runs a `;`-separated script, with store errors.
async fn batchOn(connection: borrow mut PgConnection, sql: StringView) -> Result<u64, StoreError> {
    match (await connection.batch(sql)) {
        Ok(n) => { return Ok(n); }
        Err(e) => { return Err(dbError(e, connection)); }
    }
}

/// Runs a statement for its effect, with store errors.
async fn executeOn(
    connection: borrow mut PgConnection,
    sql: StringView,
    params: borrow PgParams,
) -> Result<u64, StoreError> {
    match (await connection.execute(sql, params)) {
        Ok(n) => { return Ok(n); }
        Err(e) => { return Err(dbError(e, connection)); }
    }
}

/// Runs a query into `rows`, with store errors.
async fn queryOn(
    connection: borrow mut PgConnection,
    sql: StringView,
    params: borrow PgParams,
    rows: borrow mut PgRows,
) -> Result<void, StoreError> {
    match (await connection.queryInto(sql, params, rows)) {
        Ok() => { return Ok(); }
        Err(e) => { return Err(dbError(e, connection)); }
    }
}

/// A parameter added, or `OutOfMemory`.
fn bound(outcome: Result<void, PgError>) -> Result<void, StoreError> {
    match (outcome) {
        Ok() => { return Ok(); }
        Err(_) => { return Err(StoreError.OutOfMemory); }
    }
}
