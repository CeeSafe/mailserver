// IP addresses as 16 bytes (IPv4 mapped into IPv6, ::ffff:a.b.c.d), parsed from and written as text.

/// An IP address: 16 bytes, IPv4 mapped.
public struct IpAddress {
    public bytes: [u8; 16];

    public fn isV4(borrow this) -> bool {
        for (i in 0..10) {
            if (this.bytes[i] != 0) {
                return false;
            }
        }
        return this.bytes[10] == 0xff && this.bytes[11] == 0xff;
    }

    public fn v4(a: u8, b: u8, c: u8, d: u8) -> IpAddress {
        var bytes = [0u8; 16];
        bytes[10] = 0xff;
        bytes[11] = 0xff;
        bytes[12] = a;
        bytes[13] = b;
        bytes[14] = c;
        bytes[15] = d;
        return IpAddress { bytes: bytes };
    }

    public fn fromSocket(address: SocketAddress) -> IpAddress {
        match (address) {
            SocketAddress.V4(a, _) => { return IpAddress.v4(a[0], a[1], a[2], a[3]); }
            SocketAddress.V6(a, _, _) => { return IpAddress { bytes: a }; }
        }
    }

    /// The socket address of this IP and `port`.
    public fn socket(borrow this, port: u16) -> SocketAddress {
        if (this.isV4()) {
            return SocketAddress.V4([this.bytes[12], this.bytes[13], this.bytes[14], this.bytes[15]], port);
        }
        return SocketAddress.V6(this.bytes, port, 0);
    }

    public fn equals(borrow this, other: IpAddress) -> bool {
        for (i in 0..16) {
            if (this.bytes[i] != other.bytes[i]) {
                return false;
            }
        }
        return true;
    }

    /// Whether the first `bits` bits (counted within the IPv4 or IPv6 address) equal `other`'s.
    public fn inNetwork(borrow this, network: IpAddress, bits: u32) -> bool {
        if (this.isV4() != network.isV4()) {
            return false;
        }
        let total: u32 = if (this.isV4()) 32 else 128;
        let start: usize = if (this.isV4()) 12 else 0;
        let n = if (bits > total) total else bits;
        var i: usize = 0;
        var left = n;
        while (left >= 8) {
            if (this.bytes[start + i] != network.bytes[start + i]) {
                return false;
            }
            i += 1;
            left -= 8;
        }
        if (left > 0) {
            let mask = truncate<u8>(0xff00u32 >> left);
            return (this.bytes[start + i] & mask) == (network.bytes[start + i] & mask);
        }
        return true;
    }
}

/// Parses dotted IPv4 (`192.0.2.1`) or IPv6 (`2001:db8::1`, `::ffff:192.0.2.1`) text.
public fn parseIp(text: Slice<u8>) -> IpAddress? {
    match (text.indexOfByte(0x3a)) {
        Some(_) => { return parseV6(text); }
        null => { return parseV4(text); }
    }
}

fn parseV4(text: Slice<u8>) -> IpAddress? {
    var parts = [0u32; 4];
    var count: usize = 0;
    var digits: usize = 0;
    for (c in text) {
        if (c == 0x2e) {
            if (digits == 0 || count == 3) {
                return null;
            }
            count += 1;
            digits = 0;
        } else if (c >= 0x30 && c <= 0x39) {
            if (digits > 0 && parts[count] == 0) {
                return null; // no leading zeros (they would be octal elsewhere)
            }
            parts[count] = parts[count] * 10 + ((c - 0x30) as u32);
            digits += 1;
            if (parts[count] > 255) {
                return null;
            }
        } else {
            return null;
        }
    }
    if (count != 3 || digits == 0) {
        return null;
    }
    return IpAddress.v4(truncate<u8>(parts[0]), truncate<u8>(parts[1]), truncate<u8>(parts[2]), truncate<u8>(parts[3]));
}

fn hexDigit(c: u8) -> u32 {
    if (c >= 0x30 && c <= 0x39) {
        return (c - 0x30) as u32;
    }
    if (c >= 0x61 && c <= 0x66) {
        return (c - 0x61 + 10) as u32;
    }
    if (c >= 0x41 && c <= 0x46) {
        return (c - 0x41 + 10) as u32;
    }
    return 16;
}

fn parseV6(text: Slice<u8>) -> IpAddress? {
    var groups = [0u16; 8];
    var count: usize = 0;
    var gap: usize = 9; // where `::` was, or 9 for none
    var i: usize = 0;
    if (text.length >= 2 && text[0] == 0x3a && text[1] == 0x3a) {
        gap = 0;
        i = 2;
    } else if (text.length > 0 && text[0] == 0x3a) {
        return null;
    }
    while (i < text.length) {
        // A trailing dotted IPv4 part.
        var j = i;
        var dotted = false;
        while (j < text.length && text[j] != 0x3a) {
            if (text[j] == 0x2e) {
                dotted = true;
            }
            j += 1;
        }
        if (dotted) {
            if (j != text.length || count > 6) {
                return null;
            }
            let v4 = parseV4(text[i..j])?;
            groups[count] = ((v4.bytes[12] as u16) << 8) | (v4.bytes[13] as u16);
            groups[count + 1] = ((v4.bytes[14] as u16) << 8) | (v4.bytes[15] as u16);
            count += 2;
            i = j;
            break;
        }
        if (j == i || j - i > 4 || count >= 8) {
            return null;
        }
        var value: u32 = 0;
        for (k in i..j) {
            let d = hexDigit(text[k]);
            if (d > 15) {
                return null;
            }
            value = value * 16 + d;
        }
        groups[count] = truncate<u16>(value);
        count += 1;
        i = j;
        if (i < text.length) {
            i += 1; // the colon
            if (i < text.length && text[i] == 0x3a) {
                if (gap != 9) {
                    return null;
                }
                gap = count;
                i += 1;
            } else if (i == text.length) {
                return null; // a trailing single colon
            }
        }
    }
    var bytes = [0u8; 16];
    if (gap == 9) {
        if (count != 8) {
            return null;
        }
        for (g in 0..8) {
            bytes[g * 2] = truncate<u8>(groups[g] >> 8);
            bytes[g * 2 + 1] = truncate<u8>(groups[g]);
        }
    } else {
        if (count > 7) {
            return null;
        }
        let tail = count - gap;
        for (g in 0..gap) {
            bytes[g * 2] = truncate<u8>(groups[g] >> 8);
            bytes[g * 2 + 1] = truncate<u8>(groups[g]);
        }
        for (g in 0..tail) {
            let at = 8 - tail + g;
            bytes[at * 2] = truncate<u8>(groups[gap + g] >> 8);
            bytes[at * 2 + 1] = truncate<u8>(groups[gap + g]);
        }
    }
    return IpAddress { bytes: bytes };
}

fn putDecimal(out: borrow mut Vector<u8>, n: u32) -> Result<void, AllocError> {
    if (n >= 100) {
        out.pushBE(0x30u8 + truncate<u8>(n / 100))?;
    }
    if (n >= 10) {
        out.pushBE(0x30u8 + truncate<u8>((n / 10) % 10))?;
    }
    return out.pushBE(0x30u8 + truncate<u8>(n % 10));
}

const HEX: StringView = "0123456789abcdef";

/// Appends the address as text: dotted IPv4, or IPv6 with every group written out in lowercase hex (the
/// non-abbreviated form, which SPF's macros and Authentication-Results both accept).
public fn appendIp(out: borrow mut Vector<u8>, ip: IpAddress) -> Result<void, AllocError> {
    if (ip.isV4()) {
        for (i in 0..4) {
            if (i > 0) {
                out.pushBE(0x2eu8)?;
            }
            putDecimal(out, ip.bytes[12 + i] as u32)?;
        }
        return Ok();
    }
    let hex = HEX.bytes();
    for (g in 0..8) {
        if (g > 0) {
            out.pushBE(0x3au8)?;
        }
        let value = ((ip.bytes[g * 2] as u32) << 8) | (ip.bytes[g * 2 + 1] as u32);
        var started = false;
        var shift: u32 = 12;
        loop {
            let d = (value >> shift) & 0xf;
            if (d != 0 || started || shift == 0) {
                out.pushBE(hex[d as usize])?;
                started = true;
            }
            if (shift == 0) {
                break;
            }
            shift -= 4;
        }
    }
    return Ok();
}

/// Appends the address in RFC 5952's canonical text: dotted IPv4, or IPv6 in lowercase hex without leading zeros,
/// with the longest run of two or more zero groups (the first, on a tie) written `::`. For people and keys; SPF's
/// macros use `appendIp`.
public fn appendIpCanonical(out: borrow mut Vector<u8>, ip: IpAddress) -> Result<void, AllocError> {
    if (ip.isV4()) {
        return appendIp(out, ip);
    }
    var groups = [0u32; 8];
    for (g in 0..8) {
        groups[g] = ((ip.bytes[g * 2] as u32) << 8) | (ip.bytes[g * 2 + 1] as u32);
    }
    var bestAt: usize = 8;
    var bestLength: usize = 1;
    var g: usize = 0;
    while (g < 8) {
        if (groups[g] != 0) {
            g += 1;
            continue;
        }
        var end = g;
        while (end < 8 && groups[end] == 0) {
            end += 1;
        }
        if (end - g > bestLength) {
            bestAt = g;
            bestLength = end - g;
        }
        g = end;
    }
    let hex = HEX.bytes();
    g = 0;
    while (g < 8) {
        if (g == bestAt) {
            out.extend("::".bytes())?;
            g += bestLength;
            continue;
        }
        if (g > 0 && g != bestAt + bestLength) {
            out.pushBE(0x3au8)?;
        }
        let value = groups[g];
        var started = false;
        var shift: u32 = 12;
        loop {
            let d = (value >> shift) & 0xf;
            if (d != 0 || started || shift == 0) {
                out.pushBE(hex[d as usize])?;
                started = true;
            }
            if (shift == 0) {
                break;
            }
            shift -= 4;
        }
        g += 1;
    }
    return Ok();
}

/// Appends the reverse-lookup name of `ip`: `4.3.2.1.in-addr.arpa`, or the nibbles under `ip6.arpa`.
public fn appendReverseName(out: borrow mut Vector<u8>, ip: IpAddress) -> Result<void, AllocError> {
    if (ip.isV4()) {
        var i: usize = 4;
        while (i > 0) {
            i -= 1;
            putDecimal(out, ip.bytes[12 + i] as u32)?;
            out.pushBE(0x2eu8)?;
        }
        return out.extend("in-addr.arpa".bytes());
    }
    let hex = HEX.bytes();
    var i: usize = 16;
    while (i > 0) {
        i -= 1;
        out.pushBE(hex[(ip.bytes[i] & 0x0f) as usize])?;
        out.pushBE(0x2eu8)?;
        out.pushBE(hex[(ip.bytes[i] >> 4) as usize])?;
        out.pushBE(0x2eu8)?;
    }
    return out.extend("ip6.arpa".bytes());
}
