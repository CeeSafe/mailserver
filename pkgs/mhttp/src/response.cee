// HTTP/1.1 responses: a status, a few header fields and a body held in memory, written with Content-Length.

import msmtp.Wire;
import msmtp.WireError;
import msmtp.appendDate;

/// A response to send. `contentType` empty means none (for bodiless responses).
@noncopy
public struct Response {
    public status: u16;
    public contentType: String;
    headers: Vector<Header>;
    public body: Vector<u8>;

    public fn create(status: u16) -> Response =>
        Response {
            status: status,
            contentType: String.create(),
            headers: Vector<Header>.create(),
            body: Vector<u8>.create(),
        };

    /// A response with `body` of type `contentType`.
    public fn of(status: u16, contentType: StringView, body: Vector<u8>) -> Result<Response, AllocError> {
        var r = Response.create(status);
        r.contentType.append(contentType)?;
        r.body = body;
        return Ok(r);
    }

    /// A JSON response.
    public fn json(status: u16, body: Vector<u8>) -> Result<Response, AllocError> =>
        Response.of(status, "application/json; charset=utf-8", body);

    /// A plain text response.
    public fn text(status: u16, text: StringView) -> Result<Response, AllocError> {
        var body = Vector<u8>.create();
        body.extend(text.bytes())?;
        return Response.of(status, "text/plain; charset=utf-8", body);
    }

    /// `{"error": message}`, the admin API's error shape.
    public fn error(status: u16, message: StringView) -> Result<Response, AllocError> {
        var w = JsonWriter.create();
        w.beginObject();
        w.stringField("error", message);
        w.endObject();
        return Response.json(status, w.finish()?);
    }

    /// Adds a header field. Names and values come from the program, not from requests: CR and LF are refused.
    public fn header(borrow mut this, name: StringView, value: StringView) -> Result<void, AllocError> {
        if (name.indexOf("\r") != null || name.indexOf("\n") != null || value.indexOf("\r") != null ||
            value.indexOf("\n") != null) {
            return Ok();
        }
        var h = Header { name: String.create(), value: String.create() };
        h.name.append(name)?;
        h.value.append(value)?;
        return this.headers.push(h);
    }
}

/// The reason phrase for the statuses this server sends.
public fn reasonOf(status: u16) -> StringView {
    if (status == 100) {
        return "Continue";
    }
    if (status == 200) {
        return "OK";
    }
    if (status == 201) {
        return "Created";
    }
    if (status == 204) {
        return "No Content";
    }
    if (status == 207) {
        return "Multi-Status";
    }
    if (status == 301) {
        return "Moved Permanently";
    }
    if (status == 302) {
        return "Found";
    }
    if (status == 304) {
        return "Not Modified";
    }
    if (status == 400) {
        return "Bad Request";
    }
    if (status == 401) {
        return "Unauthorized";
    }
    if (status == 403) {
        return "Forbidden";
    }
    if (status == 404) {
        return "Not Found";
    }
    if (status == 405) {
        return "Method Not Allowed";
    }
    if (status == 409) {
        return "Conflict";
    }
    if (status == 411) {
        return "Length Required";
    }
    if (status == 412) {
        return "Precondition Failed";
    }
    if (status == 413) {
        return "Content Too Large";
    }
    if (status == 415) {
        return "Unsupported Media Type";
    }
    if (status == 422) {
        return "Unprocessable Content";
    }
    if (status == 424) {
        return "Failed Dependency";
    }
    if (status == 429) {
        return "Too Many Requests";
    }
    if (status == 431) {
        return "Request Header Fields Too Large";
    }
    if (status == 500) {
        return "Internal Server Error";
    }
    if (status == 501) {
        return "Not Implemented";
    }
    if (status == 502) {
        return "Bad Gateway";
    }
    if (status == 503) {
        return "Service Unavailable";
    }
    if (status == 507) {
        return "Insufficient Storage";
    }
    if (status == 505) {
        return "HTTP Version Not Supported";
    }
    return "Status";
}

/// The response's head and body as bytes, into `out`. `head` (a HEAD request) leaves the body out but keeps its
/// length; `keepAlive` false adds `Connection: close`.
public fn renderResponse(
    response: borrow Response,
    keepAlive: bool,
    head: bool,
    nowSeconds: i64,
    out: borrow mut Vector<u8>,
) -> Result<void, AllocError> {
    out.extend("HTTP/1.1 ".bytes())?;
    appendNumber(out, response.status as u64)?;
    out.extend(" ".bytes())?;
    out.extend(reasonOf(response.status).bytes())?;
    out.extend("\r\nDate: ".bytes())?;
    // RFC 5322's date with "+0000" is RFC 9110's IMF-fixdate with "GMT".
    var date = Vector<u8>.create();
    appendDate(mut date, nowSeconds)?;
    out.extend(date[0..date.length - 5])?;
    out.extend("GMT\r\nServer: mailserver\r\n".bytes())?;
    if (response.contentType.length > 0) {
        out.extend("Content-Type: ".bytes())?;
        out.extend(response.contentType.bytes())?;
        out.extend("\r\n".bytes())?;
    }
    // 1xx, 204 and 304 have no body and no Content-Length (RFC 9110 §8.6).
    let bodiless = response.status < 200 || response.status == 204 || response.status == 304;
    if (!bodiless) {
        out.extend("Content-Length: ".bytes())?;
        appendNumber(out, response.body.length as u64)?;
        out.extend("\r\n".bytes())?;
    }
    for (h in response.headers.view()) {
        out.extend(h.name.bytes())?;
        out.extend(": ".bytes())?;
        out.extend(h.value.bytes())?;
        out.extend("\r\n".bytes())?;
    }
    if (!keepAlive) {
        out.extend("Connection: close\r\n".bytes())?;
    }
    out.extend("\r\n".bytes())?;
    if (!head && !bodiless) {
        out.extend(response.body.view())?;
    }
    return Ok();
}

/// Sends the response and flushes it.
public async fn writeResponse(
    wire: borrow mut Wire,
    response: borrow Response,
    keepAlive: bool,
    head: bool,
) -> Result<void, WireError> {
    var out = Vector<u8>.create();
    match (renderResponse(response, keepAlive, head, Clock.unixMillis() / 1000, mut out)) {
        Ok() => {}
        Err(_) => { return Err(WireError.OutOfMemory); }
    }
    return await wire.sendNow(out.view());
}

fn appendNumber(out: borrow mut Vector<u8>, value: u64) -> Result<void, AllocError> {
    var digits = [0u8; 20];
    var n = value;
    var at: usize = 20;
    loop {
        at -= 1;
        digits[at] = 0x30u8 + truncate<u8>(n % 10);
        n = n / 10;
        if (n == 0) {
            break;
        }
    }
    return out.extend(digits[at..]);
}
