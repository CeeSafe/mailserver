// The session's pure parts: LIST patterns, mailbox names, literal markers, flag bits, and the snapshot that maps
// sequence numbers to UIDs.

fn matches(pattern: StringView, name: StringView) -> bool => listMatches(pattern.bytes(), name.bytes());

@test
fn listPatterns() -> Result<void, TestFailure> {
    Check.isTrue(matches("*", "a/b/c") && matches("*", ""), "* matches anything")?;
    Check.isTrue(matches("%", "Sent") && !matches("%", "a/b"), "% stops at the delimiter")?;
    Check.isTrue(matches("a/%", "a/b") && !matches("a/%", "a/b/c") && !matches("a/%", "a"), "a/%")?;
    Check.isTrue(matches("a/*", "a/b/c") && !matches("a/*", "ab"), "a/*")?;
    Check.isTrue(matches("%/%", "a/b") && !matches("%/%", "a/b/c"), "%/%")?;
    Check.isTrue(matches("*c", "a/b/c") && matches("a*c", "abc") && !matches("a*c", "abd"), "* inside")?;
    Check.isTrue(matches("Arch%e", "Archive") && !matches("Arch%e", "Arch/e"), "% inside")?;
    Check.isTrue(!matches("", "a") && matches("", ""), "the empty pattern")?;
    Check.isTrue(matches("Sent", "Sent") && !matches("sent", "Sent"), "other names keep their case")?;
    Check.isTrue(matches("inbox", "INBOX") && matches("InBo%", "INBOX") && matches("inbox/%", "INBOX/x"), "INBOX")?;
    Check.isTrue(!matches("inbox/X", "INBOX/x"), "only the INBOX part is caseless")?;
    Check.isTrue(!matches("inboxes", "INBOX") && !matches("inbox", "INBOXES"), "INBOX whole")?;
    // Many wildcards stay linear: no exponential backtracking.
    var pattern = Vector<u8>.create();
    for (i in 0..2000) {
        pattern.push(if (i % 2 == 0) 0x2a else 0x61)!;
    }
    pattern.push(0x62)!;
    var name = Vector<u8>.create();
    for (i in 0..1000) {
        name.push(0x61)!;
    }
    Check.isTrue(!listMatches(pattern.view(), name.view()), "*a*a…b does not match a…a")?;
    return Ok();
}

@test
fn mailboxNames() -> Result<void, TestFailure> {
    Check.isTrue(isParentOf("a".bytes(), "a/b".bytes()) && isParentOf("a/b".bytes(), "a/b/c".bytes()), "parents")?;
    Check.isTrue(!isParentOf("a".bytes(), "ab".bytes()) && !isParentOf("a".bytes(), "a".bytes()), "not parents")?;
    Check.isTrue(!isParentOf("a".bytes(), "a/".bytes()), "a trailing delimiter names nothing under it")?;
    Check.isTrue(trimDelimiter("foo/".bytes()) == "foo".bytes(), "foo/")?;
    Check.isTrue(trimDelimiter("foo//".bytes()) == "foo".bytes() && trimDelimiter("/".bytes()).length == 0, "/")?;
    Check.isTrue(trimDelimiter("a/b".bytes()) == "a/b".bytes(), "a/b")?;
    return Ok();
}

@test
fn literalMarkers() -> Result<void, TestFailure> {
    let sync = trailingLiteral("a APPEND INBOX {123}".bytes())!;
    Check.isTrue(sync.size == 123 && sync.synchronizing, "{123}")?;
    let plus = trailingLiteral("a LOGIN {7+}".bytes())!;
    Check.isTrue(plus.size == 7 && !plus.synchronizing, "{7+}")?;
    Check.isTrue(trailingLiteral("a NOOP".bytes()) == null, "no literal")?;
    Check.isTrue(trailingLiteral("a {}".bytes()) == null && trailingLiteral("a 12}".bytes()) == null, "malformed")?;
    Check.isTrue(trailingLiteral("a {+}".bytes()) == null, "no digits")?;
    Check.isTrue(trailingLiteral("{12345678901}".bytes()) == null, "too many digits")?;
    return Ok();
}

@test
fn flagBits() -> Result<void, TestFailure> {
    Check.isTrue(imapBits(STORED_SEEN) == FLAG_SEEN && imapBits(STORED_DELETED) == FLAG_DELETED, "single bits")?;
    let all = STORED_SEEN | STORED_ANSWERED | STORED_FLAGGED | STORED_DELETED | STORED_DRAFT;
    Check.isTrue(imapBits(all) == (FLAG_SEEN | FLAG_ANSWERED | FLAG_FLAGGED | FLAG_DELETED | FLAG_DRAFT), "all")?;
    var out = Vector<u8>.create();
    writeStoredFlags(mut out, STORED_SEEN | STORED_ANSWERED, "$Label1 Work".bytes())!;
    Check.isTrue(out.view() == "(\\Answered \\Seen $Label1 Work)".bytes(), "flags and keywords")?;
    out.clear();
    writeStoredFlags(mut out, 0, "Work".bytes())!;
    Check.isTrue(out.view() == "(Work)".bytes(), "keywords alone")?;
    out.clear();
    writeStoredFlags(mut out, 0, "".bytes())!;
    Check.isTrue(out.view() == "()".bytes(), "none")?;
    return Ok();
}

fn snapshotOf(uids: Slice<u32>) -> Snapshot {
    var s = Snapshot.create();
    for (u in uids) {
        s.push(u, 1)!;
    }
    s.announced = s.count();
    return s;
}

@test
fn snapshotNumbering() -> Result<void, TestFailure> {
    var s = snapshotOf([3u32, 5, 9, 10, 20][..]);
    Check.isTrue(s.count() == 5 && s.uidAt(1) == 3 && s.uidAt(5) == 20 && s.lastUid() == 20, "in order")?;
    Check.isTrue(s.seqOf(9)! == 3 && s.seqOf(4) == null && s.seqOf(21) == null, "seqOf")?;
    Check.isTrue(!s.push(15, 1)! && s.count() == 5, "a UID below the last is not new")?;
    // Expunge 5 and 10 (sequence 2 and 4): announced from the highest down, each right when read.
    Check.isTrue(s.markGone(5) && s.markGone(10) && !s.markGone(6), "markGone")?;
    Check.isTrue(s.hasGone() && s.count() == 5 && s.isGone(2), "kept until announced")?;
    var seqs = Vector<u32>.create();
    s.takeGone(mut seqs)!;
    Check.isTrue(seqs.length == 2 && seqs[0] == 4 && seqs[1] == 2, "4 then 2")?;
    Check.isTrue(s.count() == 3 && s.uidAt(1) == 3 && s.uidAt(2) == 9 && s.uidAt(3) == 20, "renumbered")?;
    Check.isTrue(s.announced == 3 && !s.hasGone(), "the client's count follows")?;
    // New messages are added at the end; the client is told later (EXISTS).
    Check.isTrue(s.push(21, 7)! && s.count() == 4 && s.announced == 3 && s.modseqAt(4) == 7, "a new message")?;
    s.setModseq(1, 9);
    Check.isTrue(s.modseqAt(1) == 9, "modseq")?;
    return Ok();
}

@test
fn snapshotKeepOnly() -> Result<void, TestFailure> {
    var s = snapshotOf([1u32, 2, 3, 4, 5, 6][..]);
    // The store has 1, 3, 6 (and 7, which the session has not seen).
    s.keepOnly([1u32, 3, 6, 7][..], 0xffffffff);
    var seqs = Vector<u32>.create();
    s.takeGone(mut seqs)!;
    Check.isTrue(seqs.length == 3 && seqs[0] == 5 && seqs[1] == 4 && seqs[2] == 2, "5, 4, 2")?;
    Check.isTrue(s.count() == 3 && s.uidAt(3) == 6, "1, 3, 6 left")?;
    // Above `upTo` nothing is judged.
    var t = snapshotOf([1u32, 2, 3][..]);
    t.keepOnly([1u32][..], 2);
    Check.isTrue(t.isGone(2) && !t.isGone(3), "upTo")?;
    t.clear();
    Check.isTrue(t.count() == 0 && t.lastUid() == 0 && t.announced == 0, "cleared")?;
    return Ok();
}
