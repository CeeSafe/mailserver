// MTA-STS parsing and matching (RFC 8461), with the RFC's own examples where it gives them.

fn idOf(text: StringView) -> StringView => stsRecordId(text) ?? "<none>";

@test
fn readsTheTxtRecord() -> Result<void, TestFailure> {
    // §3.1's example.
    Check.isTrue(idOf("v=STSv1; id=20160831085700Z;") == "20160831085700Z", "the RFC's record")?;
    Check.isTrue(idOf("v=STSv1;id=abc") == "abc", "no spaces, no final semicolon")?;
    Check.isTrue(idOf("v=STSv1; id=abc; ext=1") == "abc", "unknown fields are ignored")?;
    Check.isTrue(idOf("id=abc; v=STSv1") == "<none>", "v must come first")?;
    Check.isTrue(idOf("v=STSv2; id=abc") == "<none>", "another version is not a record")?;
    Check.isTrue(idOf("v=STSv1") == "<none>", "an id is required")?;
    Check.isTrue(idOf("v=STSv1; id=a-b") == "<none>", "the id is letters and digits")?;
    return Check.isTrue(idOf("v=STSv1; id=123456789012345678901234567890123") == "<none>", "at most 32 characters");
}

@test
fn parsesThePolicyFile() -> Result<void, TestFailure> {
    var p = StsPolicy.create();
    // §3.2's example, with CRLF line endings.
    let text =
        "version: STSv1\r\nmode: enforce\r\nmx: mail.example.com\r\nmx: *.example.net\r\nmx: backupmx.example.com\r\nmax_age: 604800\r\n";
    Check.isTrue(parseStsPolicy(text, mut p)!, "the RFC's policy")?;
    Check.isTrue(p.mode == STS_ENFORCE && p.maxAge == 604800 && p.mx.length == 3, "its fields")?;
    Check.isTrue(p.allows("mail.example.com") && p.allows("MAIL.Example.COM."), "an exact name, any case")?;
    Check.isTrue(p.allows("mx1.example.net") && !p.allows("a.b.example.net"), "a wildcard is one label")?;
    Check.isTrue(!p.allows("example.net") && !p.allows("evil.com"), "nothing else")?;
    Check.isTrue(
        parseStsPolicy("version: STSv1\nmode: testing\nmx: x.test\nmax_age: 86400\nextension: 1\n", mut p)!,
        "LF, and an unknown key",
    )?;
    Check.isTrue(p.mode == STS_TESTING, "testing")?;
    Check.isTrue(parseStsPolicy("version: STSv1\nmode: none\nmax_age: 86400\n", mut p)!, "none needs no mx")?;
    Check.isTrue(
        parseStsPolicy("version: STSv1\nmode: enforce\nmx: a.test\nmax_age: 99999999999\n", mut p)!,
        "a long max_age",
    )?;
    Check.isTrue(p.maxAge == 31557600, "is cut to a year")?;
    Check.isTrue(!parseStsPolicy("mode: enforce\nmx: a.test\nmax_age: 1\n", mut p)!, "version is required")?;
    Check.isTrue(!parseStsPolicy("version: STSv1\nmode: enforce\nmax_age: 1\n", mut p)!, "enforce needs mx")?;
    Check.isTrue(!parseStsPolicy("version: STSv1\nmode: strict\nmx: a.test\nmax_age: 1\n", mut p)!, "an unknown mode")?;
    Check.isTrue(!parseStsPolicy("version: STSv1\nmode: enforce\nmx: a.test\n", mut p)!, "max_age is required")?;
    return Check.isTrue(!parseStsPolicy("<html>not found</html>", mut p)!, "not a policy at all");
}
